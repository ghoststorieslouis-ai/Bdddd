local function patch(path, edits)
	local okR, src = pcall(readfile, path)
	if not okR or type(src) ~= "string" then warn("[Addons] cannot read " .. path); return end
	local orig, changed = src, 0
	for _, e in ipairs(edits) do
		if src:find(e.new, 1, true) then
			-- already patched
		else
			local s, f = src:find(e.old, 1, true)
			if s then
				src = src:sub(1, s - 1) .. e.new .. src:sub(f + 1)
				changed = changed + 1
			else
				warn("[Addons] not found in " .. path .. ": " .. e.old)
			end
		end
	end
	if changed > 0 then
		if not isfile(path .. ".bak") then pcall(writefile, path .. ".bak", orig) end
		writefile(path, src)
	end
	log(path .. ": " .. changed .. " patch(es) applied")
end

