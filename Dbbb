local conns, alive = {}, true
local function on(sig, f)
	local c = sig:Connect(f)
	table.insert(conns, c)
	return c
end
local function off()
	alive = false
	SH.Fast = nil -- Core's own loops resume
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
