local function getWS() return RS:FindFirstChild("WaveState") end
local function ev(name) local f = RS:FindFirstChild("RemoteEvents"); return f and f:FindFirstChild(name) end
local function fn(name) local f = RS:FindFirstChild("RemoteFunctions"); return f and f:FindFirstChild(name) end
local function parseWaves(str)
	local t = {}
	for n in tostring(str or ""):gmatch("%d+") do t[tonumber(n)] = true end
	return t
end
-- attach to a child of ReplicatedStorage now and whenever it is (re)created
local function watch(name, onFound)
	local function attach(inst)
		if inst.Name == name then onFound(inst) end
	end
	local e = RS:FindFirstChild(name)
	if e then attach(e) end
	on(RS.ChildAdded, attach)
end

-- ===================== Auto Skip =====================
local skipWave, skipAt = nil, 0
local skipStr, skipSet = nil, {}
local function trySkip()
	if not MS.Skip then return end
	local ws = getWS()
	if not ws then return end
	local wave = ws:GetAttribute("CurrentWave")
	if typeof(wave) ~= "number" then return end
	if skipWave and wave < skipWave then skipWave = nil end
	if MS.SkipStop ~= skipStr then skipStr = MS.SkipStop; skipSet = parseWaves(skipStr) end
	if skipSet[wave] then return end
	local res = ws:GetAttribute("Result")
	if res == "Win" or res == "Lose" then return end
	if ws:GetAttribute("CanSkipWave") ~= true then return end
	if player:GetAttribute("SkipVoteWave") == wave then return end
	local now = os.clock()
	if skipWave == wave and now - skipAt < 0 then return end -- retry only if the vote did not register
	local r = ev("SkipWaveVote")
	if not r then return end
	skipWave, skipAt = wave, now
	r:FireServer(wave)
	say("Skipped wave " .. wave, SH.C and SH.C.green)
end

-- ===================== Game Speed =====================
local SP = { st = nil, fetchAt = 0, fetching = false, fireAt = 0, n = 0, rev = -1 }
local trySpeed
local function applySpeedState(s)
	if type(s) ~= "table" then return end
	local rev = tonumber(s.Revision)
	if rev and rev < SP.rev then return end
	if rev then SP.rev = rev end
	SP.st = s
end
local function fetchSpeed()
	if SP.fetching then return end
	local f = fn("GetGameSpeedState")
	if not f then return end
	SP.fetching = true
	task.spawn(function()
		local ok, s = pcall(function() return f:InvokeServer() end)
		SP.fetching = false
		SP.fetchAt = os.clock()
		if ok then applySpeedState(s) end
		if alive then trySpeed() end
	end)
end
trySpeed = function()
	if not MS.Speed then return end
	local sr = ev("SetGameSpeed")
	if not sr then return end
	local st = SP.st
	if not st then fetchSpeed(); return end
	local ws = getWS()
	local cur = (ws and tonumber(ws:GetAttribute("GameSpeed"))) or tonumber(st.Speed)
	local max = (st.Locked == true) and 1 or (tonumber(st.MaxSpeed) or 1)
	local want = math.min(tonumber(MS.SpeedVal) or 1, max)
	if type(st.Options) == "table" then
		local best
		for _, o in pairs(st.Options) do
			o = tonumber(o)
			if o and o <= want + 0.001 and (not best or o > best) then best = o end
		end
		if best then want = best end
	end
	if cur and math.abs(cur - want) < 0.001 then SP.n = 0; return end
	local now = os.clock()
	if now - SP.fireAt < 0 then return end
	SP.fireAt = now
	SP.n = SP.n + 1
	sr:FireServer(want)
	say(("Speed x%s (max x%s)"):format(want, max), SH.C and SH.C.green)
end
do
	local rem = ev("GameSpeedChanged")
	if rem then
		on(rem.OnClientEvent, function(s)
			applySpeedState(s)
			trySpeed()
		end)
	end
end

-- ===================== Pre-match vote =====================
local READY = "Ready"
pcall(function() READY = require(RS.Shared.ModeVoteConfig).ReadySignal or READY end)
local votedKey
local function tryVote(mv)
	mv = mv or RS:FindFirstChild("ModeVote")
	if not mv then return end
	if mv:GetAttribute("Active") ~= true then votedKey = nil; return end
	if not MS.Pre then return end
	local key = tostring(mv:GetAttribute("EndsAt") or "x")
	if votedKey == key then return end
	local vr = mv:FindFirstChild("Vote")
	if not vr then return end
	votedKey = key
	vr:FireServer(MS.Diff)
	vr:FireServer(READY)
	say("Pre match: voted " .. tostring(MS.Diff), SH.C and SH.C.green)
end
watch("ModeVote", function(mv)
	on(mv:GetAttributeChangedSignal("Active"), function() tryVote(mv) end)
	on(mv:GetAttributeChangedSignal("EndsAt"), function() tryVote(mv) end)
	on(mv.ChildAdded, function() tryVote(mv) end)
	tryVote(mv)
end)

-- ===================== Match end (Replay / Lobby / Continue / Return) =====================
local E = { handled = false, act = nil, at = 0, tries = 0, lastTry = 0 }
local played = 0
local function endPump()
	local ws = getWS()
	if not ws then return end
	local res = ws:GetAttribute("Result")
	if res ~= "Win" and res ~= "Lose" then E.handled = false; E.act = nil; return end
	if not E.handled then
		E.handled = true
		played = played + 1
		local limit = MS.Return and played >= (tonumber(MS.Limit) or 1)
		if limit then played = 0 end
		local act = limit and "Lobby" or MS.EndAct
		if act == nil or act == "None" then return end
		E.act, E.tries, E.lastTry = act, 0, 0
		E.at = 0
	end
	local act = E.act
	if not act then return end
	local now = os.clock()
	if now < E.at then return end
	if act == "Lobby" then
		E.act = nil
		local r = RS:FindFirstChild("ReturnToLobby")
		if r then r:FireServer() end
		say("Match " .. res .. " -> Lobby", SH.C and SH.C.green)
	elseif act == "Continue" then
		if now - E.lastTry < 0 then return end
		local r = ev("ContinueEndlessVote")
		if r then r:FireServer(true) end
		E.tries, E.lastTry = E.tries + 1, now
		if E.tries >= 3 then E.act = nil end
		say("Match " .. res .. " -> Continue", SH.C and SH.C.green)
	else -- Replay: vote immediately, keep retrying until our vote is registered
		local round = ws:GetAttribute("ReplayVoteRound")
		if typeof(round) == "number" and round > 0 and player:GetAttribute("ReplayVoteRound") == round then
			E.act = nil
			say("Match " .. res .. " -> Replay (voted)", SH.C and SH.C.green)
			return
		end
		local votes = tonumber(ws:GetAttribute("ReplayVotes")) or 0
		local req = tonumber(ws:GetAttribute("ReplayVotesRequired")) or 1
		if votes >= req then return end
		if now - E.lastTry < 0 then return end
		local r = ev("ReplayVote")
		if r then r:FireServer() end
		E.tries, E.lastTry = E.tries + 1, now
	end
end

-- ===================== wiring =====================
watch("WaveState", function(ws)
	for _, a in ipairs({ "CurrentWave", "CanSkipWave", "Result", "GameSpeed", "ReplayVoteRound", "ReplayVotes", "ReplayVotesRequired" }) do
		on(ws:GetAttributeChangedSignal(a), function()
			if a == "CurrentWave" or a == "CanSkipWave" then trySkip() end
			if a == "GameSpeed" then trySpeed() end
			if a == "Result" or a:sub(1, 6) == "Replay" then endPump() end
		end)
	end
	fetchSpeed()
	trySkip(); trySpeed(); endPump()
end)
on(player:GetAttributeChangedSignal("SkipVoteWave"), trySkip)
on(player:GetAttributeChangedSignal("ReplayVoteRound"), endPump)

-- light fallback: catches toggles turned on mid-match and any missed signal
local acc = 0
on(RunService.Heartbeat, function(dt)
	if E.act then endPump() end
	acc = acc + dt
	if acc < 0 then return end
	acc = 0
	trySkip()
	tryVote()
	if MS.Speed then
		if os.clock() - SP.fetchAt > 10 then fetchSpeed() end
		trySpeed()
	end
	endPump()
end)

-- ===================== macro playback helpers (1,2,3,9,10) =====================
-- Calls made by playback must not be re-recorded by Macro.lua's hook.
local function quiet(f, ...)
	local rec = ge.__ASM_REC
	if rec then rec.suppress = (rec.suppress or 0) + 1 end
	local res = table.pack(pcall(f, ...))
	if rec then rec.suppress = math.max(0, (rec.suppress or 1) - 1) end
	return table.unpack(res, 1, res.n)
end
local function cashObj()
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Cash")
	if v and v:IsA("ValueBase") then return v end
	v = player:FindFirstChild("Cash")
	if v and v:IsA("ValueBase") then return v end
end
local function mine(tw)
	local uid = tw:GetAttribute("OwnerUserId")
	if typeof(uid) == "number" then return uid == player.UserId end
	return tw:GetAttribute("Owner") == player.Name
end

-- (2) wait until cash >= need using the value's Changed event (no polling)
function SH.Fast.waitCash(need, timeout)
	local v = cashObj()
	if not v then return false end
	if (tonumber(v.Value) or 0) >= need then return true end
	local co, done = coroutine.running(), false
	local function finish(r)
		if done then return end
		done = true
		task.spawn(co, r)
	end
	local c = v.Changed:Connect(function(x) if (tonumber(x) or 0) >= need then finish(true) end end)
	task.delay(timeout or 30, function() finish(false) end)
	local r = coroutine.yield()
	c:Disconnect()
	return r
end

-- is there already one of my towers of this unit at this spot? (prevents double placing on retry)
function SH.Fast.findPlaced(unit, pos, radius)
	local folder = workspace:FindFirstChild("Towers")
	if not folder then return nil end
	for _, tw in ipairs(folder:GetChildren()) do
		if mine(tw) then
			local u = tw:GetAttribute("UnitId") or tw.Name
			local ok, p = pcall(function() return tw:GetPivot().Position end)
			if ok and tostring(u) == tostring(unit) and (p - pos).Magnitude <= (radius or 4) then return tw end
		end
	end
end

-- (1) place with the exact recorded CFrame, verify it really exists, retry safely; returns the Model
function SH.Fast.place(unit, cf, cost, tries)
	local f = fn("PlaceTower")
	if not f then return nil end
	for i = 1, (tries or 6) do
		if not alive then return nil end
		local old = SH.Fast.findPlaced(unit, cf.Position, 4)
		if old then return old end
		if cost and cost > 0 then SH.Fast.waitCash(cost, 60) end
		local ok, m = quiet(function() return f:InvokeServer(unit, cf) end)
		if ok and typeof(m) == "Instance" and m.Parent then return m end
		-- reply lost or refused: check whether it was placed anyway before trying again
		local found = SH.Fast.findPlaced(unit, cf.Position, 4)
		if found then return found end
		task.wait(0.05 * i)
	end
	return nil
end

-- (3) upgrade with retry; returns ok, model (the model can change after an upgrade)
function SH.Fast.upgrade(model, cost, tries)
	local f = fn("UpgradeTower")
	if not f or typeof(model) ~= "Instance" then return false, model end
	for i = 1, (tries or 8) do
		if not alive then return false, model end
		if cost and cost > 0 then SH.Fast.waitCash(cost, 60) end
		local okc, ok, newm = quiet(function() return f:InvokeServer(model) end)
		if okc and ok then
			return true, (typeof(newm) == "Instance" and newm) or model
		end
		task.wait(0.05 * i)
	end
	return false, model
end

-- (9) game speed action
function SH.Fast.setSpeed(v)
	local sr = ev("SetGameSpeed")
	if sr and tonumber(v) then sr:FireServer(tonumber(v)) return true end
	return false
end
-- (10) auto ability action (card = ability card id, on = true/false)
function SH.Fast.setAutoAbility(tw, card, on)
	local f = fn("SetTowerAutoAbility")
	if not f or typeof(tw) ~= "Instance" then return false end
	local ok, r = quiet(function() return f:InvokeServer(tw, card, on ~= false) end)
	return ok and r and true or false
end
-- playback handlers for new action types. a = action, resolve(key) -> Model
--   { type = "speed", speed = 2 }
--   { type = "autoability", key = "T3", card = "Ability1", on = true }
SH.Fast.actions = {
	speed = function(a) return SH.Fast.setSpeed(a.speed) end,
	autoability = function(a, resolve)
		local tw = resolve and resolve(a.key)
		return tw and SH.Fast.setAutoAbility(tw, a.card, a.on)
	end,
}

